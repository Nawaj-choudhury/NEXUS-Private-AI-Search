APP_NAME=NEXUS API
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]
PRIVATE_VAULT_PATH=private_vault/documents
DATABASE_PATH=database/nexus.db
SESSION_COOKIE_NAME=nexus_session
SESSION_TTL_SECONDS=86400
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
BM25_K1=1.5
BM25_B=0.75
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_DOCUMENT_SIZE=20000000
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=database/vectors.db
SEMANTIC_TOP_K=10
BM25_TOP_K=10
HYBRID_TOP_K=10
RRF_K=60
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CANDIDATE_TOP_K=20
FINAL_TOP_K=5
DUPLICATE_SIMILARITY_THRESHOLD=0.9
HF_HOME=.cache/huggingface
HF_HUB_CACHE=.cache/huggingface/hub
HF_HUB_OFFLINE=false
SENTENCE_TRANSFORMERS_HOME=.cache/sentence-transformers
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
RESEARCH_TOP_K=5
MAX_CONTEXT_CHARS=6000
RESEARCH_TEMPERATURE=0.1
LOCAL_AI_ENABLED=true
CRAWLER_MAX_PAGES=10
CRAWLER_MAX_DEPTH=1
CRAWLER_TIMEOUT=10
CRAWLER_DELAY_SECONDS=0.5
CRAWLER_USER_AGENT=NEXUS-Private-AI-Search/1.0
CRAWLER_MAX_RESPONSE_SIZE=2000000
CRAWLER_ALLOW_LOCALHOST=false
GRAPH_STORE_PATH=database/knowledge_graph.db
GRAPH_MAX_DEPTH=2
GRAPH_MAX_NODES=30
GRAPH_MIN_EDGE_WEIGHT=1.0
GRAPH_MAX_CONCEPTS_PER_DOCUMENT=15
GRAPH_MIN_CONCEPT_FREQUENCY=1